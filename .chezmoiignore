.config/mach/target
.local/share/mach/backups
# Telegram bridge secret + its runtime state -- neither ever belongs under
# chezmoi management (see mach/telegram.toml.example / install.sh's
# onboarding block). Defensive: these paths already live outside
# ~/.config/mach and dot_local's own subtree, so this line is a belt-and-
# suspenders guard, not something normally reachable.
.local/share/mach/telegram.toml
.local/share/mach/telegram-state.json

# OpenAI API key for `engrain bench` (GPT-4o answer/judge runs). It sits in
# ~/.config/engrain next to the managed nature.toml, so a `chezmoi add` of
# that directory would otherwise sweep the key into this repo.
.config/engrain/openai.key

# fcitx5 rewrites these on every input-method switch, so they can never
# stay in sync: DefaultIM and the per-item Layout= lines churn whenever the
# keyboard group changes. Managing them guaranteed a permanently non-empty
# `chezmoi diff`, which in turn kept `mach kb improve` failing on
# "chezmoi source repo has uncommitted changes". Ignored rather than
# forgotten, so the seeded us/se/ru/jp group list stays in the repo for a
# fresh machine while the live file is left alone.
.config/fcitx5/profile
.config/fcitx5/conf/notifications.conf

# Hook unit tests live next to the hook sources but never deploy.
.config/claude-hooks/tests
# The shell's tests and their stand-in Quickshell modules (one qmldir declares `module Quickshell`) run from
# this source tree and never deploy next to the running shell.
.config/quickshell/ii/tests

# axon writes axon.toml itself (config.set, config.unset) and hand edits stay local.
.config/axon/axon.toml
# axon's machine data, including the deploy clone the bootstrap and sync scripts build from.
.local/share/axon

# Apps rewrite these at runtime: plasma-apply-colorscheme and the axon theme engine write kdeglobals
# and kcminputrc, and Qt writes Trolltech.conf. gtk-3.0/gtk.css is not managed and must never come
# back: it would mask the theme engine's GTK3 slot. Ignored so a broad `chezmoi add` cannot catch them.
.config/kdeglobals
.config/kcminputrc
.config/Trolltech.conf
.config/gtk-3.0/gtk.css
