.config/mach/target
.local/share/mach/backups
# Telegram bridge secret + its runtime state -- neither ever belongs under
# chezmoi management (see mach/telegram.toml.example / install.sh's
# onboarding block). Defensive: these paths already live outside
# ~/.config/mach and dot_local's own subtree, so this line is a belt-and-
# suspenders guard, not something normally reachable.
.local/share/mach/telegram.toml
.local/share/mach/telegram-state.json

# fcitx5 rewrites these on every input-method switch, so they can never
# stay in sync: DefaultIM and the per-item Layout= lines churn whenever the
# keyboard group changes. Managing them guaranteed a permanently non-empty
# `chezmoi diff`, which in turn kept `mach kb improve` failing on
# "chezmoi source repo has uncommitted changes". Ignored rather than
# forgotten, so the seeded us/se/ru/jp group list stays in the repo for a
# fresh machine while the live file is left alone.
.config/fcitx5/profile
.config/fcitx5/conf/notifications.conf
