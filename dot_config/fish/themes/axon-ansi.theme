# ANSI names only, so fish follows kitty's 16 colours, which the axon theme engine writes.
# Each role keeps the colour it had in TokyoNight Night.
# Syntax Highlighting Colors
fish_color_normal normal
fish_color_command cyan
fish_color_keyword magenta
fish_color_quote yellow
fish_color_redirection normal
fish_color_end brred
fish_color_option magenta
fish_color_error red
fish_color_param brmagenta
fish_color_comment brblack
fish_color_selection --background=brblack
fish_color_search_match --background=brblack
fish_color_operator green
fish_color_escape magenta
fish_color_autosuggestion brblack

# Completion Pager Colors
fish_pager_color_progress brblack
fish_pager_color_prefix cyan
fish_pager_color_completion normal
fish_pager_color_description brblack
