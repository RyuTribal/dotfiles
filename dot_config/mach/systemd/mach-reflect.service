[Unit]
Description=mach kb reflect — periodic knowledge-bank reflection pass
# Best-effort: a missing ollama/claude binary or an offline network must
# degrade to a quiet no-op inside `mach kb reflect` itself, not a failed
# unit — this is intentionally not wired to any other target's dependency
# chain.

[Service]
Type=oneshot
# Crash-safety net for engagement-gated reinforcement: `mach kb
# ingest-sessions` normally runs instantly per-session via kb-capture.sh's
# SessionEnd `--session-id` fast trigger, but a crash or unclean exit means
# that hook never fires at all. This bare (no --session-id) opportunistic
# sweep is the guarantee — it scans every transcript idle >=10min and not
# yet processed, so nothing is ever permanently missed. Runs before `mach
# kb reflect` (not after) so any facts it just extracted are picked up by
# the very same reflect run via `memories_since`, rather than waiting for
# the next one. `-` means a failure here never fails this unit or blocks
# the reflect pass that follows -- see ingest.rs's own offline discipline
# for why a degraded run there is always safe to retry later.
ExecStartPre=-%h/.local/bin/mach kb ingest-sessions
# Refresh the raw-transcript index (`mach kb ask`'s TRANSCRIPT: step) on the
# same wakeup. It is incremental by mtime and size, so an unchanged corpus
# costs a few seconds of stat calls and only new or grown transcripts are
# re-read. Without this the index only advances when someone runs the
# command by hand, and a stale index makes `ask` quietly answer from an
# older conversation history than the one on disk. `-` for the same reason
# as above: never fail or block the reflect pass.
ExecStartPre=-%h/.local/bin/mach kb index-transcripts
# Project registry: rename and case detection, card rebuilds, drift
# recomputation. No LLM call, so it is safe on every wakeup, and it is what
# keeps a renamed project's index from being orphaned until someone
# notices. `-` for the same reason as the steps above: never block reflect.
ExecStartPre=-%h/.local/bin/mach kb projects refresh
# Catch-up path for `mach meet process`: normally it runs as a detached
# background spawn from `mach meet stop` (see cli.rs's spawn_detached_process),
# but a meeting recorded (and stopped) while offline can leave its
# needs-processing/needs-summary marker sitting untouched if that spawn
# never got a chance to finish the claude step -- this timer's own
# opportunistic wakeup (OnUnitInactiveSec re-arm on a laptop that's merely
# awake and online) is exactly the same "eventually, when connectivity
# allows" cadence `mach meet process` itself needs, so it's the natural
# home for the catch-up call. `-` means a failure here (or simply nothing
# to do) never fails this unit or blocks the reflect pass that follows;
# transcription (local, offline-safe) always proceeds regardless of
# connectivity, only the summarize step defers -- see markers.rs.
ExecStartPre=-%h/.local/bin/mach meet process
ExecStart=%h/.local/bin/mach kb reflect
# Self-improvement pass, after reflect so any insight or affective edge the
# reflect run just derived is in this run's evidence. Same best-effort
# posture: below its signal threshold, offline, or with `claude` missing it
# exits 0 without doing anything. It edits ~/.claude/skills, CLAUDE.md,
# settings.json and ~/.config/claude-hooks only through a verified,
# snapshot-guarded chezmoi commit -- see engines/kb/src/improve.rs.
ExecStart=-%h/.local/bin/mach kb improve
