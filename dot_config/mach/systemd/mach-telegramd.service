[Unit]
Description=machd — mach daemon (telegram, kb socket)
# No ConditionPathExists here anymore: machd now also hosts the kb socket
# subsystem (serves $XDG_RUNTIME_DIR/mach-kb.sock for Claude Code's
# kb-recall.sh hook), which needs no config at all and must come up
# regardless of whether Telegram has ever been configured. The telegram
# subsystem itself now no-ops cleanly (one log line, stays up) when
# ~/.local/share/mach/telegram.toml is missing or still holds placeholder
# values -- see machd/src/main.rs's run_telegram_subsystem and
# mach/telegram.toml.example / install.sh's onboarding block.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/machd
# The long-poll loop itself backs off (30s -> 5min cap) on a repeatedly
# failing getUpdates call -- offline/asleep laptop, DNS hiccup, a Telegram
# outage -- so it does not crash-loop on its own. This Restart=on-failure
# is the outer safety net for the daemon PROCESS dying outright (panic,
# OOM-kill, a bug), not for ordinary connectivity loss.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
